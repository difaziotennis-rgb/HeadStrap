# Public site URL (no trailing slash) — used for Stripe return URLs, emails, metadata
NEXT_PUBLIC_BASE_URL=https://edifazioart.net

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=

# Webhook signing secret (Dashboard → Developers → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET_ART=

# Sale notification email via Gmail SMTP
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: override recipient (defaults to Ellendifazio@yahoo.com in code)
ART_SALE_NOTIFY_EMAIL=
